# Copy to .env (`make up` does this for you). Never commit .env.
# Everything here is a placeholder: real domains, keys and VPN credentials stay on the server.

POSTGRES_USER=study
POSTGRES_PASSWORD=study
POSTGRES_DB=study
POSTGRES_PORT=5432
INGEST_PORT=8000
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
METABASE_PORT=3000

# Catch-all study email domain. Keep a reserved TLD (.test/.invalid) in dev.
STUDY_EMAIL_DOMAIN=example.test

# Only behind a TLS-intercepting proxy: path to a CA bundle for pip during `docker build`.
EXTRA_CA_FILE=

# Fleet sizing (host is not final). See fleet/fleet.yaml.
FLEET_HOST_RAM_GB=64
FLEET_HOST_CPUS=16
REDROID_IMAGE=redroid-gapps:16.0.0-placeholder
REDROID_DATA_ROOT=/srv/redroid/data
VPN_GATEWAY_IMAGE=qmcgaw/gluetun:v3.40
VPN_ENV_DIR=/etc/study/vpn

# Feeds
FEED_ADAPTER=fake
# SPORTRADAR_API_KEY=            # only once a contract exists; never commit

# Ops
SLACK_WEBHOOK_URL=
ADB_BIN=adb
SCREENSHOT_ROOT=/srv/study/screenshots
LIVE_VISIT_LOCK_DIR=/run/study/live-visit
SNAPSHOT_ROOT=/srv/study/snapshots
# Command that prints the public IP for a market gateway; {market} is substituted (uk, de, ...).
VPN_CHECK_CMD=docker exec vpn-gw-{market} wget -qO- http://127.0.0.1:8000/v1/publicip/ip
