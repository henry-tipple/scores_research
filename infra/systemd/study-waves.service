# Template. Install with infra/systemd/install.sh.
[Unit]
Description=Study wave scheduler (start/stop instances per fleet.yaml waves)
After=docker.service

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@REPO_DIR@
EnvironmentFile=@ENV_FILE@
Environment=PYTHONPATH=@REPO_DIR@/ops:@REPO_DIR@/fleet
ExecStart=@REPO_DIR@/.venv/bin/python -m ops.waves
TimeoutStartSec=10min
